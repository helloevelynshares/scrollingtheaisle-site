    {"id": "clarification_rate", "type": "rate"},
    {"id": "assessment_completion_rate", "type": "rate"},
    {"id": "helpfulness_rate", "type": "rate", "requires_feedback": true},
    {"id": "query_latency_ms_p50", "type": "latency"},
    {"id": "query_latency_ms_p95", "type": "latency"},
    {"id": "assessment_latency_ms_p50", "type": "latency"},
    {"id": "assessment_latency_ms_p95", "type": "latency"},
    {"id": "llm_token_cost_usd", "type": "cost"},
